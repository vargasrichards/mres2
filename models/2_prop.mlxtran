corr_h_0_beta_exp = {value=0.6372111, method=MLE}
corr_h_0_delta0 = {value=0.5412044, method=MLE}
corr_p_b_exp = {value=0.2375612, method=MLE}
corr_p_beta_exp = {value=-0.3907369, method=MLE}
corr_p_delta0 = {value=-0.03141833, method=MLE}
corr_p_h_0 = {value=-0.3300869, method=MLE}
corr_rho_exp_b_exp = {value=-0.7770605, method=MLE}
corr_rho_exp_beta_exp = {value=0.571483, method=MLE}
corr_rho_exp_delta0 = {value=0.7673579, method=MLE}
corr_rho_exp_h_0 = {value=0.7433476, method=MLE}
corr_rho_exp_p = {value=0.1780991, method=MLE}
corr_sigma_b_exp = {value=-0.1201142, method=MLE}
corr_sigma_beta_exp = {value=-0.09247049, method=MLE}
corr_sigma_delta0 = {value=0.4518259, method=MLE}
corr_sigma_h_0 = {value=0.069124, method=MLE}
corr_sigma_p = {value=0.7561128, method=MLE}
corr_sigma_rho_exp = {value=0.5955815, method=MLE}
corr_tc_b_exp = {value=-0.8011409, method=MLE}
corr_tc_beta_exp = {value=0.6097383, method=MLE}
corr_tc_delta0 = {value=0.7877161, method=MLE}
corr_tc_h_0 = {value=0.7550575, method=MLE}
corr_tc_p = {value=0.01759215, method=MLE}
corr_tc_rho_exp = {value=0.8812391000000001, method=MLE}
corr_tc_sigma = {value=0.5414531, method=MLE}
corr_td_b_exp = {value=0.5406644, method=MLE}
corr_td_beta_exp = {value=-0.6024856, method=MLE}
corr_td_delta0 = {value=-0.1528084, method=MLE}
corr_td_h_0 = {value=-0.3225825, method=MLE}
corr_td_p = {value=-0.1877857, method=MLE}
corr_td_rho_exp = {value=-0.4709388, method=MLE}
corr_td_sigma = {value=-0.1528719, method=MLE}
corr_td_tc = {value=-0.3650431, method=MLE}
delta0_pop = {value=1.2126559, method=MLE}
h_0_pop = {value=0.6448496, method=MLE}
omega_alpha_exp = {value=1, method=MLE}
omega_b_exp = {value=1.2355779, method=MLE}
omega_beta_exp = {value=0.6337593, method=MLE}
omega_delta0 = {value=1.0727434, method=MLE}
omega_h_0 = {value=0.1985932, method=MLE}
omega_p = {value=0.4934776, method=MLE}
omega_rho_exp = {value=0.5169929, method=MLE}
omega_sigma = {value=0.6674052, method=MLE}
omega_tc = {value=1.3188147, method=MLE}
omega_td = {value=0.4510911, method=MLE}
p_pop = {value=2.7195583, method=MLE}
phi_exp_pop = {value=-1.5391575, method=MLE}
rho_exp_pop = {value=-1.5240011, method=MLE}
sigma_pop = {value=0.4281325, method=MLE}
tc_pop = {value=6.9264077, method=MLE}
td_pop = {value=1.8329139, method=MLE}

<MONOLIX>

[TASKS]
populationParameters()
individualParameters(method = {conditionalMean, conditionalMode })
fim(method = StochasticApproximation)
logLikelihood(method = ImportanceSampling)

[PLOTS]
run = true
plots = {indfits = {selected = true}, parameterdistribution = {selected = true}, obspred = {selected = true}, covariancemodeldiagnosis = {selected = true}, covariatemodeldiagnosis = {selected = true}, vpc = {selected = true}, npc = {selected = true}, residualsscatter = {selected = true}, residualsdistribution = {selected = true}, randomeffects = {selected = true}, blq = {selected = true}, predictiondistribution = {selected = true}, likelihoodcontribution = {selected = true}, saemresults = {selected = true}, condmeanresults = {selected = true}, fisher = {selected = true}, likelihoodresults = {selected = true}}

[SETTINGS]
GLOBAL:
seed = 12345
exportpath = '2_prop'

POPULATION:
exploratoryautostop = no
smoothingautostop = no
burniniterations = 10
smoothingiterations = 500
exploratoryiterations = 1500
simulatedannealingiterations = 1500

