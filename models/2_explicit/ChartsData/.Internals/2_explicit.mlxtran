<DATAFILE>

[FILEINFO]
file={path='../../../../iyaniwura/chim_filtered_3stream.csv'}
delimiter = comma
header={ID, TIME, DV, CENS, MDV, LIMIT, YTYPE}

[CONTENT]
ID = {use=identifier}
TIME = {use=time}
DV = {use=observation, yname={'1', '2', '3'}, type={continuous, continuous, continuous}}
CENS = {use=censored}
MDV = {use=missingdependentvariable}
LIMIT = {use=limit}
YTYPE = {use=observationtype}

<MODEL>

[INDIVIDUAL]
input = {b_exp_pop, omega_b_exp, beta_exp_pop, omega_beta_exp, dF_pop, delta0_pop, omega_delta0, h_0_pop, omega_h_0, ifn0_pop, omega_ifn0, p_pop, omega_p, phi_exp_pop, q_exp_pop, omega_q_exp, rho_exp_pop, omega_rho_exp, sigma_pop, omega_sigma, tc_pop, omega_tc, td_pop, omega_td, corr_delta0_beta_exp, corr_p_beta_exp, corr_td_beta_exp, corr_beta_exp_b_exp, corr_h_0_beta_exp, corr_tc_beta_exp, corr_rho_exp_beta_exp, corr_q_exp_beta_exp, corr_ifn0_beta_exp, corr_p_delta0, corr_td_delta0, corr_delta0_b_exp, corr_h_0_delta0, corr_tc_delta0, corr_rho_exp_delta0, corr_q_exp_delta0, corr_ifn0_delta0, corr_td_p, corr_p_b_exp, corr_p_h_0, corr_tc_p, corr_rho_exp_p, corr_q_exp_p, corr_p_ifn0, corr_td_b_exp, corr_td_h_0, corr_td_tc, corr_td_rho_exp, corr_td_q_exp, corr_td_ifn0, corr_h_0_b_exp, corr_tc_b_exp, corr_rho_exp_b_exp, corr_q_exp_b_exp, corr_ifn0_b_exp, corr_tc_h_0, corr_rho_exp_h_0, corr_q_exp_h_0, corr_ifn0_h_0, corr_tc_rho_exp, corr_tc_q_exp, corr_tc_ifn0, corr_rho_exp_q_exp, corr_rho_exp_ifn0, corr_q_exp_ifn0, corr_sigma_beta_exp, corr_sigma_delta0, corr_sigma_p, corr_td_sigma, corr_sigma_b_exp, corr_sigma_h_0, corr_tc_sigma, corr_sigma_rho_exp, corr_sigma_q_exp, corr_sigma_ifn0}

DEFINITION:
b_exp = {distribution=normal, typical=b_exp_pop, sd=omega_b_exp}
beta_exp = {distribution=normal, typical=beta_exp_pop, sd=omega_beta_exp}
dF = {distribution=logNormal, typical=dF_pop, no-variability}
delta0 = {distribution=logNormal, typical=delta0_pop, sd=omega_delta0}
h_0 = {distribution=logNormal, typical=h_0_pop, sd=omega_h_0}
ifn0 = {distribution=logNormal, typical=ifn0_pop, sd=omega_ifn0}
p = {distribution=normal, typical=p_pop, sd=omega_p}
phi_exp = {distribution=normal, typical=phi_exp_pop, no-variability}
q_exp = {distribution=normal, typical=q_exp_pop, sd=omega_q_exp}
rho_exp = {distribution=normal, typical=rho_exp_pop, sd=omega_rho_exp}
sigma = {distribution=logNormal, typical=sigma_pop, sd=omega_sigma}
tc = {distribution=logitNormal, max=12, typical=tc_pop, sd=omega_tc}
td = {distribution=logNormal, typical=td_pop, sd=omega_td}
correlation = {level=id, r(beta_exp, b_exp)=corr_beta_exp_b_exp, r(delta0, b_exp)=corr_delta0_b_exp, r(h_0, b_exp)=corr_h_0_b_exp, r(ifn0, b_exp)=corr_ifn0_b_exp, r(p, b_exp)=corr_p_b_exp, r(q_exp, b_exp)=corr_q_exp_b_exp, r(rho_exp, b_exp)=corr_rho_exp_b_exp, r(sigma, b_exp)=corr_sigma_b_exp, r(tc, b_exp)=corr_tc_b_exp, r(td, b_exp)=corr_td_b_exp, r(delta0, beta_exp)=corr_delta0_beta_exp, r(h_0, beta_exp)=corr_h_0_beta_exp, r(ifn0, beta_exp)=corr_ifn0_beta_exp, r(p, beta_exp)=corr_p_beta_exp, r(q_exp, beta_exp)=corr_q_exp_beta_exp, r(rho_exp, beta_exp)=corr_rho_exp_beta_exp, r(sigma, beta_exp)=corr_sigma_beta_exp, r(tc, beta_exp)=corr_tc_beta_exp, r(td, beta_exp)=corr_td_beta_exp, r(h_0, delta0)=corr_h_0_delta0, r(ifn0, delta0)=corr_ifn0_delta0, r(p, delta0)=corr_p_delta0, r(q_exp, delta0)=corr_q_exp_delta0, r(rho_exp, delta0)=corr_rho_exp_delta0, r(sigma, delta0)=corr_sigma_delta0, r(tc, delta0)=corr_tc_delta0, r(td, delta0)=corr_td_delta0, r(ifn0, h_0)=corr_ifn0_h_0, r(p, h_0)=corr_p_h_0, r(q_exp, h_0)=corr_q_exp_h_0, r(rho_exp, h_0)=corr_rho_exp_h_0, r(sigma, h_0)=corr_sigma_h_0, r(tc, h_0)=corr_tc_h_0, r(td, h_0)=corr_td_h_0, r(p, ifn0)=corr_p_ifn0, r(q_exp, ifn0)=corr_q_exp_ifn0, r(rho_exp, ifn0)=corr_rho_exp_ifn0, r(sigma, ifn0)=corr_sigma_ifn0, r(tc, ifn0)=corr_tc_ifn0, r(td, ifn0)=corr_td_ifn0, r(q_exp, p)=corr_q_exp_p, r(rho_exp, p)=corr_rho_exp_p, r(sigma, p)=corr_sigma_p, r(tc, p)=corr_tc_p, r(td, p)=corr_td_p, r(rho_exp, q_exp)=corr_rho_exp_q_exp, r(sigma, q_exp)=corr_sigma_q_exp, r(tc, q_exp)=corr_tc_q_exp, r(td, q_exp)=corr_td_q_exp, r(sigma, rho_exp)=corr_sigma_rho_exp, r(tc, rho_exp)=corr_tc_rho_exp, r(td, rho_exp)=corr_td_rho_exp, r(tc, sigma)=corr_tc_sigma, r(td, sigma)=corr_td_sigma, r(td, tc)=corr_td_tc}

[LONGITUDINAL]
input = {a1, b2}

file = '../../../../iyaniwura/candidate_models_iyaniwura/explicit_ifn_.txt'

DEFINITION:
y1 = {distribution=normal, prediction=ValueVt, errorModel=constant(a1)}
y2 = {distribution=normal, prediction=ValueVi, errorModel=proportional(b2)}

<FIT>
data = {'1', '2'}
model = {y1, y2}

<PARAMETER>
a1 = {value=0.8625688, method=MLE}
b2 = {value=0.3928739, method=MLE}
